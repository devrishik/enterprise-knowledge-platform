# ============================================================
# Enterprise Knowledge Intelligence Platform — configuration
# Copy to .env and adjust. NEVER commit real API keys.
# ============================================================

# --- Database -----------------------------------------------------------
# Docker Compose service name; use localhost for local development.
EKIP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ekip

# Vector storage backend:
#   pgvector  — production: native pgvector column + HNSW cosine ANN search
#   array     — compatibility: double precision[] + in-Python cosine, for
#               PostgreSQL installs without the pgvector extension
EKIP_VECTOR_BACKEND=pgvector

# --- LLM provider ---------------------------------------------------------
# openai     — default; requires EKIP_OPENAI_API_KEY
# extractive — deterministic offline provider (no API key, no external calls);
#              demonstrates the grounding/citation contract mechanically
# Local LLM alternative (verified path): run Ollama (https://ollama.com) and set
#   EKIP_LLM_PROVIDER=openai
#   EKIP_OPENAI_BASE_URL=http://127.0.0.1:11434/v1   # Ollama is OpenAI-compatible
#   EKIP_OPENAI_API_KEY=ollama-local                  # any non-empty value
#   EKIP_LLM_MODEL=qwen2.5:32b                       # measured generation run; qwen2.5:3b also works
EKIP_LLM_PROVIDER=openai
EKIP_OPENAI_API_KEY=
# Optional: custom/OpenAI-compatible endpoint (Azure, vLLM, ...)
EKIP_OPENAI_BASE_URL=
EKIP_LLM_MODEL=gpt-4o-mini
EKIP_LLM_TEMPERATURE=0.1
EKIP_LLM_MAX_OUTPUT_TOKENS=1024
EKIP_LLM_TIMEOUT_SECONDS=60

# --- Embeddings -----------------------------------------------------------
EKIP_EMBEDDING_PROVIDER=sentence_transformers
EKIP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MUST match the model's output dimension (MiniLM-L6-v2 = 384)
EKIP_EMBEDDING_DIM=384
EKIP_EMBEDDING_BATCH_SIZE=32

# --- Reranker ---------------------------------------------------------------
EKIP_RERANKER_PROVIDER=crossencoder
EKIP_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Chunking ---------------------------------------------------------------
EKIP_CHUNKING_STRATEGY=structure
EKIP_CHUNK_SIZE=1200
EKIP_CHUNK_OVERLAP=200

# --- Hybrid retrieval tuning (single source of truth) ------------------------
EKIP_DENSE_TOP_K=20
EKIP_LEXICAL_TOP_K=20
EKIP_FUSION_TOP_K=10
EKIP_RERANK_TOP_K=5
EKIP_RRF_K=60
EKIP_MIN_RELEVANCE_SCORE=0.35
EKIP_MAX_QUERY_REWRITES=1

# --- Uploads -------------------------------------------------------------------
EKIP_MAX_UPLOAD_MB=25
EKIP_ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md,.markdown,.html,.htm

# --- Pricing (USD per 1M tokens; used for cost estimation) ---------------------
EKIP_MODEL_PRICING_JSON={"gpt-4o-mini": {"input_per_1m": 0.15, "output_per_1m": 0.60}, "gpt-4o": {"input_per_1m": 2.50, "output_per_1m": 10.00}}

# --- Misc -------------------------------------------------------------------------
EKIP_ENVIRONMENT=local
EKIP_LOG_LEVEL=INFO
EKIP_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
EKIP_SEED_DEMO_DATA=true
